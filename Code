clc;
clear;
close all;

%% Read Speech File
[x, Fs] = audioread('speech.wav');

% Convert stereo to mono
if size(x,2) == 2
    x = mean(x,2);
end

%% Add Gaussian Noise
noise = 0.02 * randn(size(x));
noisy = x + noise;

%% FFT of Noisy Signal
N = length(noisy);

Y = fft(noisy);

mag = abs(Y);
phase = angle(Y);

%% Estimate Noise Spectrum
noiseFFT = fft(noise);

noiseMag = abs(noiseFFT);

%% Spectral Subtraction
enhancedMag = mag - noiseMag;

% Remove negative values
enhancedMag(enhancedMag < 0) = 0;

%% Reconstruct Signal
enhancedFFT = enhancedMag .* exp(1j*phase);

enhanced = real(ifft(enhancedFFT));

%% Normalize
enhanced = enhanced / max(abs(enhanced));

%% Plot Signals

figure;

subplot(3,1,1)
plot(x)
title('Original Speech')
xlabel('Samples')
ylabel('Amplitude')
grid on

subplot(3,1,2)
plot(noisy)
title('Noisy Speech')
xlabel('Samples')
ylabel('Amplitude')
grid on

subplot(3,1,3)
plot(enhanced)
title('Enhanced Speech')
xlabel('Samples')
ylabel('Amplitude')
grid on

%% Frequency Spectrum

figure;

subplot(3,1,1)
plot(abs(fft(x)))
title('Original Spectrum')
xlabel('Frequency Bin')

subplot(3,1,2)
plot(abs(fft(noisy)))
title('Noisy Spectrum')
xlabel('Frequency Bin')

subplot(3,1,3)
plot(abs(fft(enhanced)))
title('Enhanced Spectrum')
xlabel('Frequency Bin')

%% Spectrogram

figure;

subplot(3,1,1)
spectrogram(x,256,128,256,Fs,'yaxis')
title('Original Speech')

subplot(3,1,2)
spectrogram(noisy,256,128,256,Fs,'yaxis')
title('Noisy Speech')

subplot(3,1,3)
spectrogram(enhanced,256,128,256,Fs,'yaxis')
title('Enhanced Speech')

%% Play Audio

disp('Playing Original Speech...');
sound(x,Fs);

pause(length(x)/Fs + 2);

disp('Playing Noisy Speech...');
sound(noisy,Fs);

pause(length(noisy)/Fs + 2);

disp('Playing Enhanced Speech...');
sound(enhanced,Fs);

%% Save Enhanced Speech

audiowrite('EnhancedSpeech.wav',enhanced,Fs);

disp('Speech Enhancement Completed Successfully');
